          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  SELECT DISTINCT ON (r.name) r.run_uuid, r.name FROM runs r\n  JOIN experiments e ON e.experiment_id = r.experiment_id\n  WHERE e.name = 'imdb-dataset-versions' AND r.lifecycle_stage = 'active'\n  ORDER BY r.name, r.start_time DESC) SELECT COUNT(*) FROM r",
          "refId": "A"
        }
