          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT mv.version, COALESCE(a.alias, '-') AS alias,\n  MAX(CASE WHEN t.key='dataset_version' THEN t.value END) AS trained_on,\n  to_timestamp(mv.creation_time / 1000) AS registered_at,\n  MAX(CASE WHEN m.key = 'accuracy' THEN m.value END) AS \"accuracy (own test)\", MAX(CASE WHEN m.key = 'f1' THEN m.value END) AS \"f1 (own test)\",\n  MAX(CASE WHEN m.key = 'precision' THEN m.value END) AS \"precision\", MAX(CASE WHEN m.key = 'recall' THEN m.value END) AS \"recall\", MAX(CASE WHEN m.key = 'roc_auc' THEN m.value END) AS \"roc_auc\",\n  mv.description\nFROM model_versions mv\nLEFT JOIN registered_model_aliases a ON a.name = mv.name AND a.version = mv.version\nJOIN latest_metrics m ON m.run_uuid = mv.run_id\nLEFT JOIN model_version_tags t ON t.name = mv.name AND t.version = mv.version WHERE mv.name = 'imdb-sentiment'\nGROUP BY mv.version, a.alias, mv.creation_time, mv.description ORDER BY mv.version",
