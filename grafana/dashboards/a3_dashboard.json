    {
      "type": "stat",
      "title": "Retrained model: gain on drifted data",
      "description": "Accuracy on the drifted test set: model v2 minus model v1 (percentage points)",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlflow-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (MAX(CASE WHEN a.alias='drift_retrained' THEN m.value END)\n       - MAX(CASE WHEN a.alias='a1_baseline' THEN m.value END)) * 100 AS gain\nFROM model_versions mv\nJOIN registered_model_aliases a ON a.name = mv.name AND a.version = mv.version\nJOIN latest_metrics m ON m.run_uuid = mv.run_id AND m.key = 'accuracy_on_v2_test'\nWHERE mv.name = 'imdb-sentiment'",
          "refId": "A"
        }
