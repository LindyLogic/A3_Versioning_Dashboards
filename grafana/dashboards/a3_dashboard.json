    {
      "type": "stat",
      "title": "A1 model: accuracy drop on drifted data",
      "description": "Accuracy on v2 test minus accuracy on v1 test, for the A1 model (percentage points)",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlflow-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (MAX(CASE WHEN m.key='accuracy_on_v2_test' THEN m.value END)\n       - MAX(CASE WHEN m.key='accuracy_on_v1_test' THEN m.value END)) * 100 AS drop\nFROM model_versions mv\nLEFT JOIN registered_model_aliases a ON a.name = mv.name AND a.version = mv.version\nJOIN latest_metrics m ON m.run_uuid = mv.run_id\nWHERE mv.name = 'imdb-sentiment' AND a.alias = 'a1_baseline'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
