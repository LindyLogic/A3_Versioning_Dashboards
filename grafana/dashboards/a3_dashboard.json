    {
      "type": "table",
      "title": "Dataset versions (metadata + stats)",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlflow-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  SELECT DISTINCT ON (r.name) r.run_uuid, r.name FROM runs r\n  JOIN experiments e ON e.experiment_id = r.experiment_id\n  WHERE e.name = 'imdb-dataset-versions' AND r.lifecycle_stage = 'active'\n  ORDER BY r.name, r.start_time DESC)\nSELECT replace(r.name, 'dataset-', '') AS version,\n  MAX(CASE WHEN p.key='digest' THEN p.value END) AS digest,\n  MAX(CASE WHEN p.key='drift_recipe' THEN p.value END) AS drift_recipe,\n  MAX(CASE WHEN m.key = 'n_rows' THEN m.value END) AS \"rows\", MAX(CASE WHEN m.key = 'n_train' THEN m.value END) AS \"train\", MAX(CASE WHEN m.key = 'n_test' THEN m.value END) AS \"test\",\n  MAX(CASE WHEN m.key = 'positive_rate' THEN m.value END) AS \"positive rate\", MAX(CASE WHEN m.key = 'avg_words' THEN m.value END) AS \"avg words\",\n  MAX(CASE WHEN m.key = 'vocab_size' THEN m.value END) AS \"vocabulary\"\nFROM r JOIN latest_metrics m ON m.run_uuid = r.run_uuid\nLEFT JOIN params p ON p.run_uuid = r.run_uuid\nGROUP BY r.name ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
